# Runtime artefacts produced locally
/database/*.sqlite
/database/*.sqlite-journal
/bootstrap/cache/*.php
!/bootstrap/cache/.gitignore
/docs/.DS_Store

# Local capture set; regenerate with a browser, never ship the binaries
/docs/screenshots/

# Brand-kit generator environment; the tooling is isolated from the site
/tools/brand-kit/.venv/
/tools/brand-kit/node_modules/
/tools/brand-kit/__pycache__/

# Staged repos for the 3-repo split (never committed to the main site)
/_staging/

# UX gate: cached axe-core download and screenshot output are local artifacts
/tools/ux-gate/.axe.min.js
/tools/ux-gate/_shots/
